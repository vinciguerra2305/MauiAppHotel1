<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.QuemSomos"
             Title="Quem Somos"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout Padding="25"
                         Spacing="20">

        <Label Text="Quem Somos"
               FontSize="35"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="black" />

        <Label Text="Nosso hotel oferece um ambiente confortável, acolhedor e ideal para quem busca descanso, lazer e praticidade. Contamos com acomodações preparadas para proporcionar uma estadia agradável, além de uma estrutura pensada para atender às necessidades de nossos hóspedes."
               FontSize="20"
               HorizontalTextAlignment="Center" />

        <Label Text="Oferecemos opções de hospedagem com ou sem refeições inclusas, permitindo que cada cliente escolha a modalidade que melhor combina com suas preferências. Nossa equipe está sempre à disposição para garantir um atendimento de qualidade e uma experiência especial durante toda a estadia."
               FontSize="20"
               HorizontalTextAlignment="Center" />

        <Label Text="Venha conhecer nosso hotel e desfrute de momentos de conforto e tranquilidade!"
               FontAttributes="Bold"
               FontSize="25"
               HorizontalTextAlignment="Center" />
       
        <Button Text="Voltar"
                BackgroundColor="black"
                Clicked="Button_Voltar_Clicked" />

    </VerticalStackLayout>

</ContentPage>
